---
import Base from '../layouts/Base.astro';
import { BOOKING_MAILTO } from '../consts';

const description =
  'ODDS-TEAM. Data Product Developer. Passionate in software engineering, data engineering, and data science. ♥';
---

<Base title="About" description={description}>
  <article class="section measure stack-lg">
    <header class="page-header">
      <p class="label">About</p>
      <h1>About</h1>
    </header>
    <p class="lede">{description}</p>
    <a class="button button-primary" href={BOOKING_MAILTO}>Work with me</a>
  </article>
</Base>
