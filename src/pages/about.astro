---
import Base from '../layouts/Base.astro';
import { BOOKING_MAILTO } from '../consts';

// TODO(placeholder): replace the about page summary before launch.
const description = 'Your about summary here';
---

<Base title="About" description={description}>
  <article class="section measure stack-lg">
    <header class="page-header">
      <p class="label">About</p>
      <h1>About</h1>
    </header>
    <!-- TODO(placeholder): replace the about page paragraph before launch. -->
    <p class="lede">
      Your about paragraph here. Say who you help and how you work, in your own words.
    </p>
    <a class="button button-primary" href={BOOKING_MAILTO}>Work with me</a>
  </article>
</Base>
